# Postgres (Neon via Vercel Marketplace sets this automatically)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/poker

# Telegram bot (from @BotFather)
BOT_TOKEN=
BOT_USERNAME=my_poker_bot
# Short name of the Mini App created with /newapp (t.me/<bot>/<short_name>)
MINIAPP_SHORT_NAME=poker
# Random string; Telegram sends it in X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=
# Random string protecting /api/setup
SETUP_SECRET=
# Random string used to sign website session cookies (falls back to BOT_TOKEN-derived key)
SESSION_SECRET=

# Upstash QStash (reminders and blind-level notifications)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Public URL of the app (defaults to https://$VERCEL_PROJECT_PRODUCTION_URL)
APP_URL=http://localhost:3000

# Local development only: enables /api/auth/dev to log in without Telegram
DEV_LOGIN=1
